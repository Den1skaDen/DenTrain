{
  "name": "dentrain-email-verification",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "ratelimits": [
    { "name": "REQUEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RECIPIENT_LIMIT", "namespace_id": "1002", "simple": { "limit": 1, "period": 60 } },
    { "name": "RESET_REQUEST_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "RESET_RECIPIENT_LIMIT", "namespace_id": "1004", "simple": { "limit": 1, "period": 60 } }
  ]
}
